{
  "name": "@fcteam/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Componentes y web de seguimiento de eventos de Smoothcomp (FC Team). src/ui es la librería de diseño; src/app, la web que la usa.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/estilos.ts"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/limpiar-sitio.mjs",
    "build": "vite build",
    "build:lib": "node scripts/limpiar-lib.mjs && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
