# Material de investigación: se conservan en local, no se versionan.
fixtures/*.html
fixtures/network_log_1535_session.json

# La web compilada (npm --prefix web run build) y el data.json que genera el scraper
# en el modo estático. En la rama gh-pages sí se publican; en main no.
site/

# Frontend (web/): dependencias y la librería de componentes compilada
web/node_modules/
web/dist/

# Simulación del torneo (copia aislada, nunca se publica)
tmp-demo/

# Registro del día del evento
registro/

# Listas de grupo del servidor: nombres de personas, no van al repo (es público)
data/

# Apuntes locales con la clave de administrador de Fly.io. El repo es público.
localhost.txt

# /design-sync: scripts del conversor y su salida, estado de la máquina y borradores de subagentes.
